<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>API Alerts</Title>
    <Authors>API Alerts</Authors>
    <Version>2.0.0</Version>
    <Description>C# client for the API Alerts notification platform. Effortless project notifications — send once, deliver everywhere.</Description>
    <Summary>C# client for the API Alerts notification platform.</Summary>
    <Copyright>Copyright © API Alerts 2025</Copyright>
    <PackageTags>apialerts notifications alerts monitoring push</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://apialerts.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/apialerts/apialerts-csharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RootNamespace>APIAlerts</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
